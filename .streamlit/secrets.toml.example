# Copy these keys into Streamlit Cloud: Manage app -> Settings -> Secrets.
# NEVER commit a real secrets.toml (it is listed in .gitignore).
# For local runs you usually do not need this file at all: the app falls back
# to the local PostgreSQL database "baggage_demo".

# Neon connection string (from Neon console -> Connect).
# Use the pooled endpoint (host contains "-pooler") for the deployed app.
DATABASE_URL = "postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DBNAME?sslmode=require"

# Demo staff logins shown on the login page (change for a public deployment).
STAFF_PASSWORD = "staff9120"
SUPERVISOR_PASSWORD = "super9120"
